{
  "compilerOptions": {
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "module": "esnext",
    "target": "es2022",
    "moduleResolution": "bundler",
    "noEmit": true,
    "types": ["node"]
  },
  "include": [
    "lib/**/*.ts",
    "server/**/*.ts",
    "ingest/**/*.ts",
    "query/**/*.ts",
    "scripts/**/*.ts",
    "retrieval-eval/**/*.ts"
  ]
}
