# Titration (self-hosted) — copy to .env and fill in. .env is gitignored; never commit it.

# Required. Your Postgres+pgvector connection. `docker-compose.yml` starts one on
# localhost:5432 with this exact user/password/db.
TITRATION_DATABASE_URL=postgres://titration:titration@localhost:5432/titration

# Optional. OpenRouter API key: embeddings + OpenRouter judges. Unset = `npm run
# setup` still loads the base (unembedded, vector search off) and OpenRouter
# judges are skipped from the panel.
OPENROUTER_API_KEY=

# Optional. Override the embedding model (lib/embed.ts). Must match the
# cards.embedding vector(1536) dimension in db/001_schema.sql.
TITRATION_EMBED_MODEL=

# Optional. Judge panel source for establish_baseline/verify/goal_titrate. Unset
# (and no panel_receipt_id) refuses and names referee_panel_mint (mint + confirm a
# panel in the local picker). Set to a comma-separated subset of judges-roster.json
# ids (e.g. grok,gpt) to pick explicitly, or to "auto" to resolve one deterministically.
TITRATION_JUDGES=

# Optional. Set to any non-empty value to disable the Codex CLI judge door.
TITRATION_DISABLE_CODEX=

# Optional. Concurrent judge-call limit during grading (default 4).
TITRATION_GRADE_CONCURRENCY=

# Optional. A judges-roster.json id to use as the helper model for single-call
# advisory tools (propose_cards/edge_propose/harness_design/harness_validate)
# when no per-call override is given. Default: the first available verified door.
TITRATION_HELPER_MODEL=

# Optional. Path to an alternate judges-roster.json (absolute, or relative to the
# process cwd). Default: the repo-root judges-roster.json.
TITRATION_JUDGES_ROSTER=

# Optional. In-process concurrency cap for queued verify/establish_baseline jobs
# (default 2). A non-positive-integer value falls back to the default.
TITRATION_LOCAL_JOB_CONCURRENCY=

# Normal stdio use: leave unset/blank. Memory is selected automatically from
# client-supplied local repository roots + Git metadata, never the server cwd.
# Git must be on PATH; missing/ambiguous/failed context refuses, with no cwd fallback.
# A nonblank value AND any caller project are independent matching assertions,
# NOT overrides: invalid/conflicting values (including default/__base__) refuse.
# Old arbitrary project names cannot redirect automatic calls. Nothing is migrated.
# Legacy createMcpServer integrations WITHOUT a repository resolver retain explicit
# project > configured value > PROJECT_REQUIRED selection (not a stdio mode flag).
# Only that legacy path allows explicit default for old data and __base__ reads;
# base writes and __base__ as configured fallback remain forbidden.
# Advisory tools (classify_failure/propose_cards/harness_design) use repository memory
# when discoverable, else run without it; harness_validate stays stateless.
# See README: Automatic repository memory.
# Restart the MCP process after config changes.
TITRATION_PROJECT=

# Optional. Default project for the query/card-search.ts CLI (default "default";
# "__base__" reads the read-only starter pack).
TITRATION_TENANT=

# Optional. Default result count for the query/card-search.ts CLI (default 5).
TITRATION_K=

# Optional. Overrides the SSL policy every postgres(...) call resolves via
# lib/db-connect-core.ts — "require" or "disable". Unset = "require" for a
# non-local host, off for localhost/127.0.0.1/::1/host.docker.internal.
TITRATION_DB_SSL=

# Optional. The database URL scripts/migrate.ts applies migrations against;
# defaults to TITRATION_DATABASE_URL (this is a single-user local Postgres, so
# there is no separate migration-role database to point elsewhere).
TITRATION_MIGRATION_DATABASE_URL=

# Optional. Required to confirm `npm run migrate` against a non-local host — set
# to the exact host the apply would change. A localhost/127.0.0.1 target
# confirms itself and needs no value here.
TITRATION_MIGRATION_CONFIRM=

# Optional. Set to 1 to allow `npm run retrieval:eval -- --update-baseline` to
# re-freeze a shrunken corpus — a deliberate, documented re-freeze only.
TITRATION_RETRIEVAL_ALLOW_SHRINK=
